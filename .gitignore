# Runtime debug logs (modules/system/debug_console writes them next to the exe /
# project root at every launch)
debug.log
debug.prev.log
timeline_debug.log
repaint_trace.log

# Timeline viewer filter state (written next to the app at runtime by
# SignalTimelineScene.save_filters) — per-machine UI state, not repo content.
timeline_filters.json

# User-imported custom object detectors ("Import model…" in the Advanced tab
# copies them here). Weights are large and belong to the user, not the repo.
models/custom/

# Trained + user-imported custom ACTION models. Training and "Import model…"
# both write models/actions/ now; the flat root slots below are still read as a
# fallback, so a model from an older build keeps working. Large weights + the
# user's own label taxonomy — the user's data, never the repo's.
models/actions/
/action_classifier_3d.xml
/action_classifier_3d.bin
/action_classifier_3d.onnx
/intel_finetuned_classifier_3d_mapping.json
/r3d_finetuned.pth
/r3d_finetuned_mapping.json

# Action-trainer checkpoints and the Intel encoder's cached features. Working
# files, not the model: the model itself lands in models/actions/.
/checkpoints_r3d/
/checkpoints_intel/

# CLIP OpenVINO IR (~600 MB, generated by tools/export_clip_ov.py; CI regenerates
# it before packaging). Without it the app re-converts the model from PyTorch on
# every launch — slow, but never something to commit.
models/clip-vit-base-patch32-ov/

# RTMPose keypoint IRs + ONNX/zip cache (installed via tools/get_rtmpose_model.py)
models/rtmpose/

# YOLOX detector IRs + ONNX cache (installed via tools/get_yolox_model.py,
# and by the app on first run). Downloaded, never authored here.
models/yolox/

__pycache__/

# --- Web frontend (Vite + React + Tauri) ---
frontend/node_modules/
frontend/dist/
frontend/dev-out.log
frontend/dev-err.log
frontend/app-shot.png

# Rust build output
frontend/src-tauri/target/
frontend/src-tauri/gen/

# The PyInstaller-built sidecar is a build artifact, not source.
frontend/src-tauri/binaries/
dist-sidecar/
build-sidecar/

# The Windows installer: CI fetches 7zr.exe from 7-zip.org next to the .iss and
# compiles the Setup.exe. Both are build inputs/outputs, not source.
packaging/installer/7zr.exe
build-installer/

# --- Pipeline runtime artifacts ---
# Written next to the project when a run executes: the analysis cache, the
# per-run object log, and YOLO weights ultralytics auto-downloads on first use.
cache/
object_log.csv
yolo11n.pt
yolo11n_openvino_model/
# The ONNX export made on demand for the DirectML detection path, beside the
# weights it came from (modules/yolo_onnx.py).
yolo11*.onnx
highlight.mp4
analysis_stats.json

# User's own composition rules — app_paths.composition_rules_path() documents
# this as private/gitignored, but it was never actually listed here.
composition_rules.yaml
.gstack/
timeline_filters.json

# Analysis caches — CLIP frame indices, detection/bbox entries, thumbnails,
# the face database. All rebuilt from the source video on demand, and large.
cache/

# Training output: checkpoints, logs and run directories written by training/.
# The runs are the user's own and the weights dwarf the repo.
training/runs/

__pycache__/

# Update-check state (last check, skipped version) — per install, never shared.
update_state.json
# Updater working dirs: files being downloaded, and the ones displaced by the
# last update pending a sweep. Both appear in the install root at runtime.
.update-staging/
.update-old/
publish/
.secrets/

# User-defined composition rules and the hand labels used to tune them. The
# event names and the spans are the user's own, about their own material, and
# do not belong in the repository. The suffixed form is listed because a bare
# name does not match a backup copy, and in the sibling repo two such backups
# reached a commit before anyone noticed.
composition_rules.yaml
composition_rules.yaml.*
composition_rules.*.yaml
labels/
